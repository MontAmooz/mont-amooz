generator client {
  provider = "prisma-client-js"
  // Issue #4 / ADR-0010: CI restores node_modules from a release artifact
  // built on this machine ("native" = debian-openssl-3.0.x). Prisma's runtime
  // probe reports debian-openssl-1.1.x on some runner runtimes (e.g. bun's
  // BoringSSL compat string), so ship both engine variants in the artifact.
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  title        String? // آقای / خانم / دکتر
  bio          String?
  expertise    String? // comma-separated Persian tags
  role         String   @default("معلم") // معلم | دانش‌آموز | تایپیست | برنامه‌نویس
  isAdmin      Boolean  @default(false) // founder-only admin panel access (P10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pamphlets         Pamphlet[]         @relation("AuthoredPamphlets")
  versions          PamphletVersion[]
  reviews           Review[]
  votes             ReviewVote[]
  mergeRequests     MergeRequest[]     @relation("CreatedMRs")
  reviewedRequests  MergeRequest[]     @relation("ReviewedMRs")
  contributions     Contribution[]

  uploadedAttachments PamphletAttachment[] @relation("UploadedAttachments")
  passwordResets    PasswordResetToken[] @relation("PasswordResets")
  issuedResets      PasswordResetToken[] @relation("IssuedResets")
  notifications     Notification[]
  authoredExams     Exam[]               @relation("AuthoredExams")
  takenExams        ExamAttempt[]        @relation("TakenExams")

  // Phase 2 — teaching marketplace
  wallet            Wallet?
  txns              Txn[]
  slots             TeacherSlot[]      @relation("TeachingSlots")
  taughtSessions    ClassSession[]     @relation("TaughtSessions")
  attendedSessions  ClassSession[]     @relation("AttendedSessions")
  sentMessages      SessionMessage[]   @relation("SentMessages")
  sessionReviews    SessionReview[]    @relation("GivenSessionReviews")
  courses           VideoCourse[]      @relation("AuthoredCourses")
  enrollments       CourseEnrollment[] @relation("Enrollments")
  courseReviews     CourseReview[]     @relation("GivenCourseReviews")
  lessonProgress    LessonProgress[]

  // P15 — interactive lessons
  authoredLessons           InteractiveLesson[]         @relation("AuthoredLessons")
  interactiveLessonProgress InteractiveLessonProgress[] @relation("UserLessonProgress")

  // P19 — pamphlet Q&A
  pamphletComments PamphletComment[] @relation("PamphletCommentAuthor")
}

model Pamphlet {
  id             String   @id @default(cuid())
  title          String
  description    String?
  authorId       String
  grade          String // پایه تحصیلی
  subject        String // درس
  chapter        String? // فصل
  teachingMethod String // روش تدریس
  difficulty     String // سطح دشواری
  status         String   @default("PUBLISHED")
  forkedFromId   String? // جزوهٔ مبدأ در صورت فورک
  viewCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author     User               @relation("AuthoredPamphlets", fields: [authorId], references: [id])
  forkedFrom Pamphlet?          @relation("ForkLineage", fields: [forkedFromId], references: [id])
  forks      Pamphlet[]         @relation("ForkLineage")
  versions   PamphletVersion[]
  reviews    Review[]
  contributions Contribution[]
  attachments PamphletAttachment[]
  sourceMRs  MergeRequest[]     @relation("MRSource")
  targetMRs  MergeRequest[]     @relation("MRTarget")

  // P19 — pamphlet Q&A
  comments PamphletComment[]

  @@index([grade, subject])
  @@index([authorId])
}

model PamphletVersion {
  id            String   @id @default(cuid())
  pamphletId    String
  versionNumber Int
  content       String // Markdown
  changeSummary String?
  createdById   String
  createdAt     DateTime @default(now())

  pamphlet  Pamphlet @relation(fields: [pamphletId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])
  attachments PamphletAttachment[]

  @@unique([pamphletId, versionNumber])
  @@index([pamphletId])
}

// ADR-0012 — optional file attachment (PDF/Word/md/txt) alongside the
// Markdown content. Stored on the local fs (`uploads/pamphlet-attachments/`,
// gitignored); downloaded only through HMAC-signed URLs.
model PamphletAttachment {
  id            String   @id @default(cuid())
  pamphletId    String
  versionId     String
  fileName      String
  storageKey    String   @unique
  contentType   String
  sizeBytes     Int
  extractedText String?
  uploadedById  String
  createdAt     DateTime @default(now())

  pamphlet   Pamphlet        @relation(fields: [pamphletId], references: [id], onDelete: Cascade)
  version    PamphletVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation("UploadedAttachments", fields: [uploadedById], references: [id])

  @@index([pamphletId])
  @@index([versionId])
}

model Review {
  id           String   @id @default(cuid())
  pamphletId   String
  userId       String
  rating       Int // 1..5
  comment      String
  helpfulBase  Int      @default(0) // seed/aggregate base count (real votes add on top)
  unhelpfulBase Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pamphlet Pamphlet    @relation(fields: [pamphletId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id])
  votes    ReviewVote[]

  @@unique([pamphletId, userId])
  @@index([pamphletId])
}

model ReviewVote {
  id       String @id @default(cuid())
  reviewId String
  userId   String
  value    Int // 1 = مفید | -1 = غیرمفید

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId])
}

model MergeRequest {
  id          String    @id @default(cuid())
  sourceId    String // جزوهٔ فورک‌شده (پیشنهاددهنده)
  targetId    String // جزوهٔ اصلی
  title       String
  description String?
  status      String    @default("OPEN") // OPEN | APPROVED→MERGED | REJECTED
  createdById String
  reviewedById String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  source     Pamphlet @relation("MRSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target     Pamphlet @relation("MRTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdBy  User     @relation("CreatedMRs", fields: [createdById], references: [id])
  reviewedBy User?    @relation("ReviewedMRs", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([targetId])
}

model Contribution {
  id         String @id @default(cuid())
  pamphletId String
  userId     String
  score      Float

  pamphlet Pamphlet @relation(fields: [pamphletId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([pamphletId, userId])
}

// ===================== Phase 2 — Teaching Marketplace =====================

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0) // Toman (تومان)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Txn {
  id           String   @id @default(cuid())
  userId       String
  type         String // DEPOSIT | WITHDRAW | SESSION_PAYMENT | SESSION_REFUND | SESSION_EARNING | COURSE_PURCHASE | COURSE_EARNING
  amount       Int // signed: + credit / − debit
  balanceAfter Int
  description  String
  status       String   @default("SUCCESS") // PENDING | SUCCESS | FAILED
  refType      String? // SESSION | COURSE | GATEWAY | null
  refId        String?
  authority    String? // mock gateway authority (deposits)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([authority])
}

model TeacherSlot {
  id              String   @id @default(cuid())
  teacherId       String
  startAt         DateTime
  durationMinutes Int      @default(60)
  price           Int // Toman per session
  status          String   @default("OPEN") // OPEN | BOOKED | BLOCKED
  createdAt       DateTime @default(now())

  teacher User          @relation("TeachingSlots", fields: [teacherId], references: [id])
  session ClassSession?

  @@index([teacherId, startAt])
  @@index([status])
}

model ClassSession {
  id              String   @id @default(cuid())
  slotId          String   @unique
  teacherId       String
  studentId       String
  startAt         DateTime
  endAt           DateTime
  durationMinutes Int
  price           Int // total paid by student (Toman)
  teacherShare    Int // 80%
  commission      Int // 20% platform share
  status          String   @default("BOOKED") // BOOKED | COMPLETED | CANCELLED_STUDENT | CANCELLED_TEACHER
  meetingCode     String   @unique // 6-char uppercase alnum
  topic           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  slot     TeacherSlot     @relation(fields: [slotId], references: [id])
  teacher  User            @relation("TaughtSessions", fields: [teacherId], references: [id])
  student  User            @relation("AttendedSessions", fields: [studentId], references: [id])
  messages SessionMessage[]
  review   SessionReview?

  @@index([teacherId])
  @@index([studentId])
}

model SessionMessage {
  id        String   @id @default(cuid())
  sessionId String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([sessionId])
}

model SessionReview {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String // the student who attended
  rating    Int // 1..5
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session ClassSession @relation(fields: [sessionId], references: [id])
  user    User         @relation("GivenSessionReviews", fields: [userId], references: [id])
}

model VideoCourse {
  id          String   @id @default(cuid())
  teacherId   String
  title       String
  description String?
  grade       String
  subject     String
  level       String? // سطح دشواری (DIFFICULTIES) — optional
  price       Int      @default(0) // Toman; 0 = رایگان
  coverUrl    String?
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User               @relation("AuthoredCourses", fields: [teacherId], references: [id])
  lessons     VideoLesson[]
  enrollments CourseEnrollment[]
  reviews     CourseReview[]

  @@index([grade, subject])
  @@index([teacherId])
}

model VideoLesson {
  id              String  @id @default(cuid())
  courseId        String
  order           Int
  title           String
  description     String?
  videoUrl        String // direct mp4/https URL (signed URLs in production)
  durationMinutes Int?
  isFreePreview   Boolean @default(false)

  course   VideoCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([courseId, order])
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  courseId  String
  studentId String
  price     Int // price paid at purchase time
  createdAt DateTime @default(now())

  course  VideoCourse @relation(fields: [courseId], references: [id])
  student User        @relation("Enrollments", fields: [studentId], references: [id])

  @@unique([courseId, studentId])
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  rating    Int // 1..5
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course VideoCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User        @relation("GivenCourseReviews", fields: [userId], references: [id])

  @@unique([courseId, userId])
}

model LessonProgress {
  id         String   @id @default(cuid())
  lessonId   String
  userId     String
  watched    Boolean  @default(true)
  watchedAt  DateTime @default(now())

  lesson VideoLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id])

  @@unique([lessonId, userId])
}

// ===================== P10 — Auth Hardening =====================

// One row per rate-limited attempt (P10). Counted per key within the window;
// rows older than 24h are swept fire-and-forget after each check.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String // "login:1.2.3.4" | "register:1.2.3.4" | "reset:1.2.3.4" | "pwchange:uid"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Admin-issued password reset token (P10). No email infra — the admin hands
// the 32-char token to the user over WhatsApp/Telegram; user redeems it at
// #/reset. Single use, 24h expiry; issuing invalidates previous unused tokens.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  token       String    @unique // 32-char hex
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  user      User @relation("PasswordResets", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("IssuedResets", fields: [createdById], references: [id])

  @@index([userId])
}

// ===================== P11 — In-app Notifications =====================

// One row per notification (P11). Created by notify() after the triggering
// action commits; read state is readAt. 30s polling reads the unread count.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String // MR_RECEIVED | MR_REVIEWED | REVIEW_RECEIVED | SESSION_BOOKED | SESSION_COMPLETED | COURSE_PURCHASED
  title       String
  body        String?
  linkUrl     String? // client hash URL, e.g. "#/request/abc"
  relatedId   String?
  relatedType String? // pamphlet | mr | session | course
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

// ===================== P12 — Exam Builder =====================

// Teacher-authored exam (P12 MVP, P14 polish: essay questions + timer).
// Draft until published; questions lock once any attempt exists.
model Exam {
  id              String    @id @default(cuid())
  teacherId       String
  title           String
  description     String?
  grade           String
  subject         String
  published       Boolean   @default(false)
  durationMinutes Int? // P14 — null = no timer; 1..240 enforced at API level
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teacher   User          @relation("AuthoredExams", fields: [teacherId], references: [id])
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([published, grade, subject])
  @@index([teacherId])
}

// One exam question. type="MC" carries options JSON + correctOptionId;
// type="ESSAY" has null options/correctOptionId and is graded by the teacher.
model ExamQuestion {
  id              String   @id @default(cuid())
  examId          String
  order           Int
  text            String
  type            String   @default("MC") // "MC" | "ESSAY"
  options         String? // JSON array of {id, text} — MC only, null for ESSAY
  correctOptionId String? // MC only; null for ESSAY (teacher-graded)
  points          Int      @default(1)
  createdAt       DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, order])
  @@index([examId])
}

// A student's attempt. P14 lifecycle: IN_PROGRESS (created by /start) →
// SUBMITTED (auto-graded MC done; awaits essay grading when hasEssay) →
// GRADED (teacher scored essays). Legacy P12 rows migrate to GRADED with
// autoScore = score. answers: JSON { [questionId]: optionId | essayText }.
model ExamAttempt {
  id               String    @id @default(cuid())
  examId           String
  studentId        String
  status           String    @default("GRADED") // "IN_PROGRESS" | "SUBMITTED" | "GRADED"
  answers          String? // JSON: { [questionId]: optionId | essayText }; null until submit
  autoScore        Int       @default(0) // points from auto-graded MC
  manualScore      Int? // points from teacher-graded essays
  gradings         String? // JSON array of {questionId, awardedPoints, teacherComment}
  score            Int       @default(0) // legacy = autoScore when no manual grading; autoScore+manualScore after
  maxScore         Int
  startedAt        DateTime? // when the student clicked شروع آزمون
  submittedAt      DateTime? // submit (manual or auto on timeout)
  timeLimitReached Boolean   @default(false)

  exam    Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User @relation("TakenExams", fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([examId])
  @@index([status])
}

// ===================== P15 — Interactive Learning =====================

// Brilliant-style step lesson (P15 MVP). Steps are TEXT (markdown, rendered
// with the shared MarkdownViewer), MC (2-4 options, 1 correct) or NUMERIC
// (numeric answer + optional tolerance). Students advance only on a correct
// answer; wrong answers show the step's explanation and allow a retry.
model InteractiveLesson {
  id               String   @id @default(cuid())
  teacherId        String
  title            String
  description      String?
  grade            String
  subject          String
  published        Boolean  @default(false)
  estimatedMinutes Int? // rough estimate, shown to student
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacher  User                        @relation("AuthoredLessons", fields: [teacherId], references: [id])
  steps    InteractiveStep[]
  progress InteractiveLessonProgress[]

  @@index([published, grade, subject])
  @@index([teacherId])
}

// One step of an interactive lesson. type="MC" carries options JSON +
// correctOptionId; type="NUMERIC" carries correctNumeric + tolerance;
// type="TEXT" is read-only content (no answer to grade).
model InteractiveStep {
  id              String   @id @default(cuid())
  lessonId        String
  order           Int // 0-indexed, matches progress.currentStep
  type            String // "TEXT" | "MC" | "NUMERIC"
  content         String // TEXT: markdown; MC/NUMERIC: question text (markdown)
  options         String? // MC only: JSON array [{ id, text }]
  correctOptionId String? // MC only
  correctNumeric  Float? // NUMERIC only
  tolerance       Float? // NUMERIC only, default 0
  explanation     String? // shown on wrong answer; may contain markdown
  createdAt       DateTime @default(now())

  lesson InteractiveLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
  @@index([lessonId])
}

// One row per student per lesson. Renamed from the prompt's "LessonProgress"
// because that name is taken by the VideoCourse watch-progress model —
// this is the P15 approved adaptation (user decision, 2026-11-19).
model InteractiveLessonProgress {
  id          String    @id @default(cuid())
  lessonId    String
  userId      String
  currentStep Int       @default(0) // index into the lesson's ordered steps
  completed   Boolean   @default(false)
  responses   String    @default("{}") // JSON: { [stepId]: { answer, correct, attempts } }
  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  lesson InteractiveLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User              @relation("UserLessonProgress", fields: [userId], references: [id])

  @@unique([lessonId, userId])
  @@index([userId])
  @@index([completedAt])
}

// ===================== P19 — Pamphlet Q&A =====================

// Questions and answers on a pamphlet (P19). Single-level nesting by design:
// replies reference a top-level comment only (parent.parentId must be null).
// Soft delete — the row stays so replies keep their parent; the API returns
// an empty body for deleted comments.
model PamphletComment {
  id         String    @id @default(cuid())
  pamphletId String
  authorId   String
  parentId   String?
  body       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  pamphlet Pamphlet          @relation(fields: [pamphletId], references: [id], onDelete: Cascade)
  author   User              @relation("PamphletCommentAuthor", fields: [authorId], references: [id])
  parent   PamphletComment?  @relation("PamphletCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  PamphletComment[] @relation("PamphletCommentReplies")

  @@index([pamphletId, parentId, createdAt])
  @@index([authorId])
}
